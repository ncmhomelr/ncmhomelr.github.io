# Copia este archivo como .env para desarrollo local.
# En GitHub Pages se definen en Settings > Secrets and variables > Actions (ver README).
#
# Son opcionales: sin ellas la app arranca en Modo Simulación, y las credenciales de
# Supabase también se pueden ingresar desde el botón de engranaje de la app.

# --- Supabase (obligatorias para guardar pedidos de verdad) ---
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU-CLAVE-ANON-O-PUBLISHABLE

VITE_TELEGRAM_BOT_TOKEN=TU-TOKEN-TELEGRAM
VITE_TELEGRAM_CHAT_ID=TU-ID-TELEGRAM

# --- Mapa del checkout (opcionales) ---
# Vista inicial del mapa. Por defecto: toda Argentina (zoom 4). Centrala en tu zona de entrega.
# VITE_MAP_LAT=-31.4201
# VITE_MAP_LNG=-64.1888
# VITE_MAP_ZOOM=12
#
# Si la tienda recibe mucho tráfico, cambia de proveedor de mapas sin tocar el código
# (los servidores públicos de OpenStreetMap son para uso liviano):
# VITE_MAP_TILE_URL=https://tu-proveedor/{z}/{x}/{y}.png
# VITE_MAP_ATTRIBUTION=&copy; Tu proveedor
# VITE_GEOCODER_URL=https://tu-geocoder/search
